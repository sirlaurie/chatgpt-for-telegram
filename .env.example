# your openai api key
export OPENAI_API_KEY=

# your gemini api key
export GOOGLE_API_KEY=

# your telegram bot key
export bot_token=

# api endpoint
export api_endpoint=https://api.openai.com/v1/chat/completions
export default_api_endpoint=https://api.openai.com/v1/chat/completions

# default model
export model=gemini-2.5-flash

# your telegram id, for sending alert to your telegram
export developer_chat_id=

# database uri
export database_uri='bot.db'

# ===== Stripe Configuration (for subscription payments) =====

# Stripe API keys (get from https://dashboard.stripe.com/apikeys)
export STRIPE_SECRET_KEY=sk_test_xxx  # Use sk_live_xxx for production
export STRIPE_PUBLISHABLE_KEY=pk_test_xxx  # Use pk_live_xxx for production

# Stripe Webhook secret (get from https://dashboard.stripe.com/webhooks)
export STRIPE_WEBHOOK_SECRET=whsec_xxx

# Webhook server configuration
export WEBHOOK_BASE_URL=https://yourdomain.com  # Your public URL for webhooks
export WEBHOOK_HOST=0.0.0.0  # Host to bind webhook server
export WEBHOOK_PORT=8000  # Port for webhook server

# Optional: Stripe Price IDs (if you create products in Stripe dashboard)
# export MONTHLY_PRICE_ID=price_xxx
# export YEARLY_PRICE_ID=price_xxx
