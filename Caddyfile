# Caddy 配置文件
# Telegram Bot Webhook 服务器

# 你的实际域名
stripe.autheai.com {
    # 反向代理到 FastAPI webhook server
    reverse_proxy localhost:8000

    # 日志配置
    log {
        output file /var/log/caddy/stripe-webhook.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }

    # 安全头
    header {
        # 启用 HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains"

        # 防止 MIME 类型嗅探
        X-Content-Type-Options "nosniff"

        # XSS 保护
        X-XSS-Protection "1; mode=block"
    }
}
